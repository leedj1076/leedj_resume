# Copy to .env.local and replace placeholders for live service development.
# The public profile and offline checks run without these values.
OPENAI_API_KEY=replace-with-development-openai-key
PINECONE_API_KEY=replace-with-development-pinecone-key
PINECONE_INDEX_NAME=replace-with-development-index-name

# Both values are required for owner workflows.
ADMIN_PASSWORD=replace-with-long-unique-password
ADMIN_SESSION_SECRET=replace-with-independent-long-random-secret

# Optional persistence. Keep the service-role key on the server only.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-development-service-role-key

# Optional new-session notifications. All three values are required.
RESEND_API_KEY=replace-with-development-resend-key
RESEND_FROM=Ask DJ <sender@example.com>
RESEND_TO=owner@example.com
